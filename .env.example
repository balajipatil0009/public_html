# ITINFO Academy Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Application Settings
APP_ENV=production
SITE_NAME="ITINFO ACADEMY"
SITE_URL=http://localhost:8080
DEBUG_MODE=false

# Database Configuration
DB_HOST=localhost
DB_NAME=itinfo_academy
DB_USER=root
DB_PASS=

# Email Configuration (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here
MAIL_FROM_EMAIL=your-email@gmail.com
MAIL_FROM_NAME="IT Informer"
MAIL_TO_ADMIN=admin@example.com

# AI/API Keys
GROQ_API_KEY=your-groq-api-key-here

# Security
SESSION_TIMEOUT=3600
HASH_ALGO=PASSWORD_BCRYPT

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=../uploads/

# Job Portal (Adzuna India feed) - free keys: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
ADZUNA_CATEGORY=it-jobs
ADZUNA_RESULTS_PER_PAGE=50
ADZUNA_PAGES=5
ADZUNA_MAX_DAYS_OLD=45
ADZUNA_MAX_CALLS_PER_RUN=70
ADZUNA_MAX_CALLS_PER_DAY=120
ADZUNA_QUERIES=software developer,web developer,data analyst,data scientist,network engineer,cyber security,software testing,cloud engineer,devops,support engineer,database administrator,ui ux designer
ADZUNA_CITIES=Pune,Mumbai,Bangalore,Hyderabad,Delhi,Chennai,Nagpur,Ahmedabad,Kolkata,Gurgaon,Noida,Indore,Jaipur,Coimbatore,Kochi,Chandigarh,Surat,Lucknow
ADZUNA_THROTTLE_SECONDS=0.4
